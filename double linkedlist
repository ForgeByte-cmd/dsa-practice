class DLL
{
    public Node head;
    private class Node
    {
        private int val;
        private Node next;
        private Node prev;
        public Node(int val)
        {
            this.val=val;
        }
    }
    //Inserting element at starting
    public void insertFirst(int val)
    {
        Node node=new Node(val);
        node.next=head;
        node.prev=null;
        if(head!=null)
        {
            head.prev=node;
        }
        head=node;
    }
    //Inserting element at ending
    public void insertLast(int val)
    {
        Node node=new Node(val);
        Node last=head;
        if(head==null)
        {
            node.prev=null;
            head=node;
            return;
        }
        while(last.next!=null)
        {
            last=last.next;
        }
        last.next=node;
        node.prev=last;
    }
    //Inserting at specified position
    public void insert(int val,int index)
    {
        Node node=new Node(val);
        Node temp=head;
        if(index==0)
        {
            insertFirst(val);
            return;
        }
        for(int i=1;i<index&&temp!=null;i++)
        {
            temp=temp.next;
        }
        if(temp==null)
        {
            System.out.println("error");
            return;
        }
        if(temp.next==null)
        {
            insertLast(val);
            return;
        }
        node.next=temp.next;
        temp.next=node;
        node.prev=temp;
        if(node.next!=null)
        {
            node.next.prev=node;
        }
    }
    public Node find(int val)
    {
        Node node=head;
        while(node!=null)
        {
            if(node.val==val)
            {
                return node;
            }
            node=node.next;
        }
        return null;
    }
    //Delete first element
    public int deleteFirst()
    {
        if(head==null)
        {
            System.out.println("The list is empty");
        }
        int val=head.val;
        head=head.next;
        if(head!=null)
        {
            head.prev=null;
        }
        return val;
    }
    //Delete lsat element
    public int deleteLast()
    {
        if(head==null)
        {
            System.out.println("The list is empty");
        }
        if(head.next==null)
        {
            return deleteFirst();
        }
        Node node=head;
        while(node.next!=null)
        {
            node=node.next;
        }
        int val=node.val;
        node.prev.next=null;
        return val;
    }
    //Delete specific element
    public int delete(int val)
    {
        Node node=find(val);
        if(node==null)
        {
            return -1;
        }
        if(node.next==null)
        {
            return deleteLast();
        }
        if(node.prev==null)
        {
            return deleteFirst();
        }
        node.prev.next=node.next;
        node.next.prev=node.prev;
        return node.val;
    }
    //reverse display
    public void display()
    {
        Node node=head;
        Node last=null;
        while(node!=null)
        {
            last=node;
            node=node.next;
        }
        System.out.println("Start<-");
        while(last!=null)
        {
            System.out.print(last.val+"<-");
            last=last.prev;
        }
        System.out.println("End");
    }
}
public class sample
{
    public static void main(String[] args)
    {
        DLL list = new DLL();

        list.insertFirst(3);
        list.insertFirst(2);
        list.insertFirst(8);
        list.insertFirst(17);
        list.insertLast(99);

        // Insert element 65 at index 2
        list.insert(65, 2);

        System.out.println("--- Forward Display ---");
        list.display();
    }
}
